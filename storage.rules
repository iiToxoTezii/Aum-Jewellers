rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile pictures folder rules
    match /profiles/{userId} {
      // Anyone can read profile pictures
      allow read: if true;
      
      // Only the specific user can upload/update their own picture
      // Image must be less than 5MB and must be an image file
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }

    // Physical Cards folder rules
    match /cards/{userEmail} {
      // Anyone can read physical cards (specifically the assigned user)
      allow read: if true;
      // Admins (or authenticated users enforcing admin via frontend) can write
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
